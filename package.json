{
  "name": "cold-mail-generator",
  "version": "1.0.0",
  "description": "Automated Cold Email & Dynamic Resume Tailor application powered by NVIDIA NIM and Google OAuth2",
  "main": "server/src/index.js",
  "scripts": {
    "build": "cd server && npm install --no-audit --no-fund && cd ../client && npm install --no-audit --no-fund && npm run build && cd ..",
    "start": "node server/src/index.js",
    "dev:server": "node server/src/index.js",
    "dev:client": "npm run dev --prefix client",
    "test": "node tests/test_runner.js --suite=all",
    "test:unit": "node tests/test_runner.js --suite=unit",
    "test:integration": "node tests/test_runner.js --suite=integration",
    "test:batch": "node tests/test_runner.js --suite=batch",
    "test:security": "node tests/test_runner.js --suite=security",
    "test:performance": "node tests/test_runner.js --suite=performance",
    "test:all": "node tests/test_runner.js --suite=all",
    "test:regression": "node tests/e2e_regression_suite.js"
  },
  "keywords": [
    "cold-email",
    "resume-tailor",
    "nvidia-nim",
    "gmail-oauth2",
    "pdfkit"
  ],
  "author": "Santhosh T K",
  "license": "MIT"
}
