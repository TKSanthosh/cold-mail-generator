# ==============================================================================
#                      OPTIMIZED GITIGNORE FOR PRODUCTION
# ==============================================================================

# Dependencies & Package Managers
node_modules/
**/node_modules/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Headless Browsers & Cache
.cache/
**/.cache/**
.puppeteer/
puppeteer/
chrome/

# Environment Variables & Sensitive Secrets
.env
.env.*
!.env.example
*.env
token.json
**/token.json
client_secret*.json
naukri_session*.json
**/naukri_session*.json

# Generated User Files & PDFs
uploads/
**/uploads/**
!uploads/.gitkeep
*.pdf
*.log
logs.json
**/logs.json

# User Sandboxes & Dynamic Database Dumps
server/users/
server/data/
**/test_sandboxes/**
data/test_sandboxes/
*.json.gz
**/*.json.gz

# Build Outputs (Compiled during deployment)
dist/
client/dist/
**/dist/**
build/

# Temporary / Scratch Files
*.png
!extension/icons/*.png
*.gz
scratch/
**/scratch/**
.DS_Store
Thumbs.db
.vscode/
.idea/

# Preserve Essential Test Files
!test_e2e_live.js
!test_suite.js
!tests/**
!tests/**/*.js
