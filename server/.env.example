# Internal cron & mutation secret tokens
CRON_SECRET=d829c6fb74cf79387fcbb87c45e65acb4621c32be136680ff85b73782021a721
SYSTEM_MUTATION_KEY=e2f5a71c338201003ac9a49935eb867397e5d577eaa62adfb98da79568c96cc2

# ------------------------------------------------------------------------------
# 3. SUPABASE (DATABASE & BATCH PERSISTENCE)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://gnuezthgywjfbalrcnbh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# or SUPABASE_KEY / SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=sb_publishable_dDMl14z59IIbxq2utpKMmQ_HrISgSU9

# ------------------------------------------------------------------------------
