# ------------------------------------------------------------------------------
# 5. PUPPETEER & BROWSER AUTOMATION (HEADLESS CLOUD)
# ------------------------------------------------------------------------------
# Automatically detected on Linux/Railway/Render, or override if custom Chrome is used:
# PUPPETEER_EXECUTABLE_PATH=/opt/render/project/src/.cache/puppeteer/chrome/linux-121.0.6167.85/chrome-linux64/chrome
# PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer
NAUKRI_FORCE_HEADLESS=true

# ------------------------------------------------------------------------------
